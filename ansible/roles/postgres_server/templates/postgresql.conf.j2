# {{ ansible_managed }}
# Main config for PostgreSQL. Changes here require a
# full restart via the "restart postgresql" handler.

data_directory = '{{ pg_data_dir }}'
hba_file       = '{{ pg_conf_dir }}/pg_hba.conf'

listen_addresses = '{{ pg_listen_address }}'
port = 5432
max_connections = {{ pg_max_connections }}

# TLS encrypts traffic between web and db so credentials
# are not visible on the network.
ssl = on
ssl_cert_file = '{{ pg_conf_dir }}/server.crt'
ssl_key_file  = '{{ pg_conf_dir }}/server.key'
ssl_min_protocol_version = 'TLSv1.2'
ssl_ciphers = 'HIGH:!aNULL:!MD5:!3DES'

password_encryption = 'scram-sha-256'
row_security = on

shared_buffers = {{ pg_shared_buffers }}
work_mem = 16MB

logging_collector = on
log_destination = 'jsonlog'
log_directory = '/var/log/postgresql'
log_filename = 'postgresql-%Y-%m-%d_%H%M%S.json'
log_connections = on
log_disconnections = on
log_line_prefix = '%m [%p] %u@%d from %h '
log_statement = 'ddl'

# Rotate the log file daily or when it hits 100 MB.
# Without rotation the disk fills with audit history.
log_rotation_age = 1d
log_rotation_size = 100MB

# Loads extensions into the server at startup.
# pgaudit logs what changed, pg_stat_statements logs how slow.
shared_preload_libraries = 'pgaudit,pg_stat_statements'

# pgaudit records who changed what in the database.
# WRITE catches data changes, DDL catches schema changes.
pgaudit.log = '{{ pg_audit_log }}'
pgaudit.log_catalog = off

# pg_stat_statements collects per-query timing data so we
# can spot slow queries. Track 'all' includes nested calls.
pg_stat_statements.max = {{ pg_stat_statements_max }}
pg_stat_statements.track = all