# {{ ansible_managed }}
# Generated by Ansible. Manual edits get overwritten on the next playbook run.

# How often Prometheus asks every target for fresh numbers.
global:
  scrape_interval: {{ prometheus_scrape_interval }}

# Rules that turn metric values into alerts live in this file.
rule_files:
  - /etc/prometheus/alert_rules.yml

# Where firing alerts get sent. Alertmanager runs next to
# Prometheus on monitor-01, so localhost is fine.
alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "localhost:9093"

# Every server Prometheus reads from. The "node" job covers
# system metrics from every VM. The "postgres" job covers
# database stats via the exporter running here on monitor-01.
scrape_configs:
  - job_name: 'node'
    static_configs:
      - targets:
{% for host in groups['all'] | sort %}
          - "{{ hostvars[host]['ansible_host'] }}:9100"
{% endfor %}

  - job_name: 'postgres'
    static_configs:
      - targets:
          - "localhost:{{ postgres_exporter_port }}"