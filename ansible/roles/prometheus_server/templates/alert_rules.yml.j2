# {{ ansible_managed }}
# Generated by Ansible. Manual edits get overwritten on the next playbook run.

# Alert rules tell Prometheus when a metric becomes a problem.
# When the expression is true for the "for" duration, an alert
# fires and Alertmanager routes it.
groups:
  - name: node_health
    rules:
      # CPU usage above 80% for 30 seconds. The formula reads
      # "100 minus the idle time" — what's left is busy time.
      - alert: HighCpuUsage
        expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 80
        for: 30s
        labels:
          severity: warning
        annotations:
          summary: "CPU above 80% on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "Sustained high CPU for at least 30 seconds. Check what's running."