# {{ ansible_managed }}
# Generated by Ansible. Manual edits get overwritten on the next playbook run.

# Pre-configures Prometheus as the data source so Grafana
# finds it on first login. Without this, every fresh deploy
# needs someone to click through the setup wizard.
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://localhost:9090
    isDefault: true