# {{ ansible_managed }}
# Distributes incoming traffic across Flask backends.
# The upstream block is built from inventory — adding a
# web server to the 'web' group is enough.

upstream flask_backends {
{% for host in groups['web'] | sort %}
    server {{ hostvars[host]['ansible_host'] }}:{{ nginx_lb_backend_port }};
{% endfor %}
}

server {
    listen {{ nginx_lb_listen_port }} default_server;
    listen [::]:{{ nginx_lb_listen_port }} default_server;

    location / {
        proxy_pass http://flask_backends;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /grafana/ {
        proxy_pass http://192.168.50.250:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        access_log off;
        return 200 "ok\n";
    }
}